# VPS stack secrets — copy to .env.vps (gitignored, never commit) and fill in.
# Used by: docker compose -f compose.vps.yml --env-file .env.vps up -d

# Docker tag to run (rebuild the GHCR image first if main moved on).
IMAGE_TAG=latest

# Public fleet endpoint. DNS A record for this name must point at the VPS.
# Caddy issues HTTPS for it automatically.
PUBLIC_DOMAIN=hifi-public.example.com

# Private fleet endpoint. Same deal: DNS A record → VPS, auto HTTPS.
PRIVATE_DOMAIN=hifi-private.example.com

# Admin panel keys — generate two different ones, e.g. `openssl rand -hex 32`.
# Empty = panel open to the internet. Do not reuse across fleets.
PUBLIC_ADMIN_KEY=change-me-generate-with-openssl-rand-hex-32
PRIVATE_ADMIN_KEY=change-me-different-from-public

# Shared Valkey/Redis (Aiven). One URL for both fleets; USE= selects the DB
# (public → db 1, private → db 0). Secret — never commit the real value.
REDIS_POOL=rediss://default:PUT-PASSWORD-HERE@unified-addon-unified.d.aivencloud.com:27187

COUNTRY_CODE=US
RUST_LOG=info
