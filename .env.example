# Database path (container platforms: /data/hifi.db, serverless: leave empty for ephemeral)
DATABASE_URL=hifi.db

# Admin panel key
ADMIN_KEY=change-me-to-a-random-secret

# Tidal defaults (used when no accounts in DB)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
USER_ID=

# Default country code
COUNTRY_CODE=US

# Proxy support
USE_PROXIES=False
PROXIES_FILE=proxies.txt
FALLBACK_TO_DIRECT_CONNECTION=False
MAX_RETRIES=2

# Rate limits (defaults; can be changed at runtime via admin panel /admin/settings)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
COOLDOWN_429_SECS=60
COOLDOWN_403_SECS=120

# Server
HOST=0.0.0.0
PORT=8000

# Logging
RUST_LOG=info
