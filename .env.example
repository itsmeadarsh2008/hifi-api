# Database path (container platforms: /data/hifi.db, serverless: leave empty for ephemeral)
DATABASE_URL=hifi.db

# Admin panel key
ADMIN_KEY=change-me-to-a-random-secret

# Tidal defaults (used when no accounts in DB)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
USER_ID=
# Legacy credential file (upstream TOKEN_FILE): imported into the DB on startup
# when present. Supports per-entry catalog markers (role="catalog").
TOKEN_FILE=token.json

# Dedicated metadata credential (upstream CATALOG_*): kept out of the
# playback pool and queue. A refreshable account without a subscription is fine.
CATALOG_CLIENT_ID=
CATALOG_CLIENT_SECRET=
CATALOG_REFRESH_TOKEN=
CATALOG_USER_ID=
# ...or a static bearer token (cannot be refreshed).
# CATALOG_TOKEN=

# Default country code
COUNTRY_CODE=US

# Proxy support
USE_PROXIES=False
PROXIES_FILE=proxies.txt
FALLBACK_TO_DIRECT_CONNECTION=False
MAX_RETRIES=2
# Rotate the proxy on every token refresh (upstream ROTATE_PROXIES_ON_REFRESH)
ROTATE_PROXIES_ON_REFRESH=False
# Upstream User-Agent override (default okhttp/5.3.2)
# USER_AGENT=okhttp/5.3.2
# Verbose upstream logging (upstream DEV_MODE)
# DEV_MODE=False

# No request throttling is applied — all requests go straight to Tidal
# with account failover.
# Retry system-disabled accounts every 5m with backoff (never touches manual OFF)
AUTO_HEAL=True

# Atmos default for manifests/dash when the request doesn't specify (?atmos= overrides)
# off = FLAC first (compatible), prefer = EAC3_JOC first (needs Dolby player + Widevine)
ATMOS_MODE=prefer

# Trust X-Forwarded-For / X-Real-IP headers for client IP detection.
# Keep true when running behind a reverse proxy (Render, Fly, Railway, Nginx).
TRUST_PROXY_HEADERS=True

# Discord webhook for ban/outage alerts (403 suspensions, all-accounts-down).
# Empty = disabled. Test from the admin panel (Alerts card).
DISCORD_WEBHOOK_URL=

# Shared cross-instance state (Upstash Redis REST). Empty = disabled
# (single-host mode, everything stays local as before).
# When set on ALL instances, they share: app settings, Tidal access tokens,
# API-key usage, and credential backups.
# Set these as secrets on your host (e.g. Render dashboard) — never commit
# real values to the repo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative backend: native Redis/Valkey for this host's pool
# (rediss://user:pass@host:port/db). When set, it wins over the Upstash pair
# above — a host belongs to exactly one pool, so set only one backend per
# fleet. Same key layout, same sync behavior; spoken as raw RESP2 over TLS.
# (The previous name PUBLIC_POOL_REDIS_URL is still honored as a deprecated
# fallback — rename it when you see the startup warning.)
REDIS_POOL=

# Pool selector for the shared instance: USE=private loads db 0,
# USE=public loads db 1 (overrides any db in REDIS_POOL). Unset = the db
# from the URL (default 0). Anything else disables sync rather than
# loading the wrong pool's accounts.
# USE=private

# Server
HOST=0.0.0.0
PORT=8000

# Logging
RUST_LOG=info
