# Database path (container platforms: /data/hifi.db, serverless: leave empty for ephemeral)
DATABASE_URL=hifi.db

# Admin panel key
ADMIN_KEY=change-me-to-a-random-secret

# Tidal defaults (used when no accounts in DB)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
USER_ID=

# Default country code
COUNTRY_CODE=US

# Proxy support
USE_PROXIES=False
PROXIES_FILE=proxies.txt
FALLBACK_TO_DIRECT_CONNECTION=False
MAX_RETRIES=2

# Rate limits (defaults; can be changed at runtime via admin panel /admin/settings)
# - Per-IP limits: excess from one IP gets HTTP 429
# - Tidal limits: global upstream throttle + jitter to avoid Tidal bans
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
TIDAL_RPS=20
TIDAL_BURST=40
COOLDOWN_429_SECS=90
COOLDOWN_403_SECS=180
# Retry system-disabled accounts every 5m with backoff (never touches manual OFF)
AUTO_HEAL=True

# Intelligent limits: pool-scaled upstream caps + reserve protection
# Effective global Tidal cap ≈ TIDAL_RPS_PER_ACCOUNT × healthy accounts (capped by TIDAL_RPS)
TIDAL_RPS_PER_ACCOUNT=3
TIDAL_BURST_PER_ACCOUNT=6
# Keep at least this many accounts healthy: at/under it the pool conserves
# (trickle + fail-fast 429s) instead of burning the last accounts
RESERVE_ACCOUNTS=2
CONSERVE_TRICKLE_RPS=1
# Max Tidal calls per account per UTC day (0 = unlimited); alerts at PCT%
DAILY_BUDGET_PER_ACCOUNT=12000
DAILY_BUDGET_ALERT_PCT=80

# IP tiers: stricter bucket for Tidal-hitting routes, with graduated slowdown
# (delay up to IP_DELAY_CAP_MS) instead of instant 429s
IP_COSTLY_RPS=20
IP_COSTLY_BURST=40
IP_DELAY_CAP_MS=2000
REPUTATION_ENABLED=True
# Exact IPs, comma-separated. Allowlist bypasses limits; denylist gets 403.
IP_ALLOWLIST=
IP_DENYLIST=

# Atmos default for manifests/dash when the request doesn't specify (?atmos= overrides)
# off = FLAC first (compatible), prefer = EAC3_JOC first (needs Dolby player + Widevine)
ATMOS_MODE=prefer

# Trust X-Forwarded-For / X-Real-IP headers for client IP detection.
# Keep true when running behind a reverse proxy (Render, Fly, Railway, Nginx).
TRUST_PROXY_HEADERS=True

# Discord webhook for ban/outage alerts (403 suspensions, all-accounts-down).
# Empty = disabled. Test from the admin panel (Alerts card).
DISCORD_WEBHOOK_URL=

# Shared cross-instance state (Upstash Redis REST). Empty = disabled
# (single-host mode, everything stays local as before).
# When set on ALL instances, they share: rate-limit settings, per-account
# daily budgets, 429/403 cooldown parks, Tidal access tokens, API-key
# usage, and the global upstream throttle.
# Set these as secrets on your host (e.g. Render dashboard) — never commit
# real values to the repo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000

# Logging
RUST_LOG=info
